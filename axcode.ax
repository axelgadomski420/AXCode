    column
      gap 10
      text feature.number
        style tag
      text feature.title
        style h3
      text feature.detail
        style body
        max lines 5

component MetricBox(metric Metric)
  cardAccent
    column
      gap 6
      text metric.value
        style metric
      text metric.label
        style caption
        max lines 3

component SyntaxWindow(block SyntaxBlock)
  column
    gap 12

    row
      gap 12
      align center
      justify spaceBetween
      text block.label
        style subheading
      if expandedBlock is block.id
        button "Zwiń"
          style buttonTab
          accessibility label "Zwiń przykład kodu"
          when tapped
            toggleBlock(block.id)
      else
        button "Pokaż kod"
          style buttonTab
          accessibility label "Pokaż przykład kodu"
          when tapped
            toggleBlock(block.id)

    if expandedBlock is block.id
      card
        column
          gap 4
          list block.lines
            empty
              text "Brak treści."
                style caption
            item line
              text line
                style codeLine

component LayerRow(layer Layer)
