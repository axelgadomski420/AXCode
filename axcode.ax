app "AXCode — podręcznik i kompilator"
version "3.0.0"
language pl
supports ios android web desktop
orientation automatic
offline first
entry Podrecznik

// ============================================================================
// AXCODE — PODRĘCZNIK PEŁNY + KOMPILATOR W APLIKACJI
//
// Ten plik jest jednocześnie:
//   1. Kompletną specyfikacją języka, dwujęzyczną (polski i angielski).
//   2. Działającym kompilatorem, który przyjmuje DOWOLNY plik .ax.
//   3. Korpusem uczącym: bot czyta regułę, widzi przykład i kontrprzykład
//      z kodem błędu, więc uczy się bez metod prób i błędów.
//
// Struktura każdej reguły jest stała:
//   REGUŁA (PL + EN) → SKŁADNIA → PRZYKŁAD POPRAWNY → PRZYKŁAD BŁĘDNY
//   → KOD BŁĘDU, KTÓRY ZGŁOSI KOMPILATOR → POPRAWKA
//
// Dzięki stałej strukturze da się to przejść jak indeks, nie jak prozę.
//
// Autor: Axel G · https://www.instagram.com/axelgadomski
// ============================================================================

theme default
  follows system

  color primary #4F46E5
  color primaryDeep #312E81
  color accent #22D3EE
  color accentWarm #FBBF24
  color danger #EF4444
  color success #10B981
  color warning #F59E0B

  color background light #F7F8FC
  color background dark #07080F
  color surface light #FFFFFF
  color surface dark #0E1018
  color surfaceRaised light #FFFFFF
  color surfaceRaised dark #161A26
  color codeBg light #F1F3FA
  color codeBg dark #0A0C14

  color text light #0B0C14
  color text dark #F3F5FF
  color muted light #575E78
  color muted dark #8C93B2
  color border light #E4E7F2
  color border dark #232838

  radius small 10
  radius medium 16
  radius large 24
  radius full 999

  font body "Inter"
  font mono "JetBrains Mono"
  font display "Space Grotesk"

  shadow soft 0 2 6 #00000012
  shadow medium 0 8 30 #0000002A
  shadow glow 0 0 28 #4F46E544

style display
  font display
  font size 38
  weight bold
  line height 1.06
  letter spacing -1.1

style title
  font display
  font size 25
  weight bold
  letter spacing -0.5

style heading
  font display
  font size 18
  weight semibold

style body
  font size 16
  line height 1.6

style bodyEn
  font size 15
  line height 1.6
  color theme.muted

style caption
  font size 13
  color theme.muted
  line height 1.5

style overline
  font size 11
  weight semibold
  letter spacing 1.6
  color theme.accent

style code
  font mono
  font size 13
  line height 1.55
  background theme.codeBg
  radius medium
  padding 16

style codeBad
  font mono
  font size 13
  line height 1.55
  background theme.codeBg
  radius medium
  padding 16
  border 1 theme.danger

style codeGood
  font mono
  font size 13
  line height 1.55
  background theme.codeBg
  radius medium
  padding 16
  border 1 theme.success

style mono
  font mono
  font size 13

style pill
  background theme.surfaceRaised
  radius full
  padding 8 14
  border 1 theme.border

style pillActive
  background theme.primary
  color white
  radius full
  padding 8 14
  weight semibold

style badge
  background theme.primary
  color white
  radius full
  padding 5 12
  weight bold
  font size 12

style badgeErr
  background theme.danger
  color white
  radius full
  padding 5 12
  weight bold
  font size 12

style badgeOk
  background theme.success
  color #04140D
  radius full
  padding 5 12
  weight bold
  font size 12

style badgeWarn
  background theme.warning
  color #1A1200
  radius full
  padding 5 12
  weight bold
  font size 12

style buttonPrimary
  background theme.primary
  color white
  radius medium
  padding 16 22
  shadow glow
  weight semibold

style buttonSecondary
  background theme.surfaceRaised
  color theme.text
  radius medium
  padding 16 22
  border 1 theme.border
  weight semibold

style buttonGhost
  background transparent
  color theme.accent
  radius medium
  padding 12 16

style card
  background theme.surface
  radius large
  padding 20
  shadow medium

style cardRaised
  background theme.surfaceRaised
  radius large
  padding 20
  border 1 theme.border

style divider
  background theme.border
  height 1

// ============================================================================
// GRAMATYKA FORMALNA — zapis w notacji EBNF
//
// To jest kontrakt, nie opis. Parser implementuje dokładnie te reguły.
// Każdy symbol nieterminalny ma odpowiednik w kodzie parsera.
// Każdy terminal ma regułę leksera.
// ============================================================================

data GrammarRule
  id Text
  nonterminal Text
  production Text
  notePl Text
  noteEn Text

data RuleSet
  id Text
  number Text
  titlePl Text
  titleEn Text
  rulePl Text
  ruleEn Text
  syntax Text
  goodPl Text
  goodEn Text
  goodCode Text
  badCode Text
  errorCode Text
  errorName Text
  fixPl Text
  fixEn Text

data ErrorRow
  id Text
  code Text
  rangePl Text
  rangeEn Text
  sample Text
  causePl Text
  causeEn Text
  fixPl Text
  fixEn Text

data TrapRow
  id Text
  trapPl Text
  trapEn Text
  wrongCode Text
  rightCode Text
  whyPl Text
  whyEn Text

data Lexeme
  id Text
  kind Text
  pattern Text
  example Text
  notePl Text
  noteEn Text

store grammar local
  list GrammarRule
  key "axcode.grammar.v3"

store rules local
  list RuleSet
  key "axcode.rules.v3"

store errors local
  list ErrorRow
  key "axcode.errors.v3"

store traps local
  list TrapRow
  key "axcode.traps.v3"

store lexemes local
  list Lexeme
  key "axcode.lexemes.v3"

global state langMode Text = "both"
global state section Text = "gramatyka"
global state openRuleId Text = ""
global state announceText Text = ""

function newId() returns Text
  return "g_" + timestampMs() + "_" + randomToken(8)

function announceLocal(text Text)
  set announceText = text
  announce(text)

function announceImportant(text Text)
  set announceText = text
  announceUrgent(text)

function toggleRule(id Text)
  if openRuleId is id
    set openRuleId = ""
    announceLocal("Zamknięto regułę.")
  else
    set openRuleId = id
    announceLocal("Otwarto regułę z przykładami.")

function cycleLangMode()
  if langMode is "both"
    set langMode = "pl"
  else if langMode is "pl"
    set langMode = "en"
  else
    set langMode = "both"
  announceLocal("Tryb języka podręcznika: " + langMode)


// ============================================================================
// GRAMATYKA — pełny zapis w EBNF
// ============================================================================

function loadGrammar()
  set grammar = [
    GrammarRule(id = "gr1", nonterminal = "Plik", production = "Plik = { Sekcja } ;", notePl = "Plik składa się z dowolnej liczby sekcji. Kolejność jest dowolna.", noteEn = "A file is any number of sections. Order is free."),
    GrammarRule(id = "gr2", nonterminal = "Sekcja", production = "Sekcja = Naglowek, { LiniaTresci } ;", notePl = "Sekcja to nagłówek, a pod nim linie o głębszym wcięciu.", noteEn = "A section is a header plus lines indented deeper."),
    GrammarRule(id = "gr3", nonterminal = "Naglowek", production = "Naglowek = "app" | "theme" | "style" | "enum" | "data" | "store" | "global", "state" | "permission" | "api" | "function" | "component" | "screen" | "test" ;", notePl = "Trzynaście słów rozpoczyna sekcję najwyższego poziomu.", noteEn = "Thirteen keywords open a top-level section."),
    GrammarRule(id = "gr4", nonterminal = "Wciecie", production = "Wciecie = { Spacja | Tabulator } ;", notePl = "Tabulator ma szerokość dwóch spacji. Mieszanie tabulatorów i spacji w jednej linii to błąd AX1005.", noteEn = "A tab counts as two spaces. Mixing tabs and spaces in one line is error AX1005."),
    GrammarRule(id = "gr5", nonterminal = "Typ", production = "Typ = TypProsty | "List", "<", Typ, ">" | "Map", "<", Typ, ",", Typ, ">" | Nazwa, ["?"] ;", notePl = "Znak zapytania po typie oznacza wartość opcjonalną. List i Map można zagnieżdżać.", noteEn = "A question mark marks an optional value. List and Map nest."),
    GrammarRule(id = "gr6", nonterminal = "TypProsty", production = "TypProsty = "Text" | "Number" | "Boolean" | "Date" | "Duration" | "Json" | "File" | "Image" | "Video" | "Audio" | "Location" ;", notePl = "Jedenaście typów wbudowanych.", noteEn = "Eleven built-in types."),
    GrammarRule(id = "gr7", nonterminal = "Stan", production = "Stan = "state", Nazwa, Typ, ["=", Wyrazenie] ;", notePl = "Stan lokalny ekranu. Wymaga typu. Wartość początkowa jest opcjonalna.", noteEn = "Local screen state. Type required, initial value optional."),
    GrammarRule(id = "gr8", nonterminal = "StanGlobalny", production = "StanGlobalny = "global", "state", Nazwa, Typ, "=", Wyrazenie ;", notePl = "Stan globalny wymaga wartości początkowej. Bez niej kompilator zgłasza AX4002.", noteEn = "Global state requires an initial value. Without it the compiler reports AX4002."),
    GrammarRule(id = "gr9", nonterminal = "Instrukcja", production = "Instrukcja = Przypisanie | Dodanie | Usuniecie | Aktualizacja | ZapisMagazynu | Nawigacja | Zwrot | Wywolanie | Ogloszenie ;", notePl = "Dziewięć rodzajów instrukcji w logice.", noteEn = "Nine statement kinds in logic."),
    GrammarRule(id = "gr10", nonterminal = "Przypisanie", production = "Przypisanie = "set", Sciezka, "=", Wyrazenie ;", notePl = "Przypisanie zmienia stan albo zawartość magazynu.", noteEn = "Assignment changes state or store content."),
    GrammarRule(id = "gr11", nonterminal = "Dodanie", production = "Dodanie = "add", Wyrazenie, "to", Nazwa ;", notePl = "Dodaje element na koniec listy. Cel musi być magazynem listy.", noteEn = "Appends to a list store. The target must be a list store."),
    GrammarRule(id = "gr12", nonterminal = "Usuniecie", production = "Usuniecie = "remove", Wyrazenie, "from", Nazwa ;", notePl = "Usuwa element z listy. Brak magazynu w instrukcji to błąd AX1006.", noteEn = "Removes from a list. Missing store is error AX1006."),
    GrammarRule(id = "gr13", nonterminal = "ZapisMagazynu", production = "ZapisMagazynu = ("save" | "load" | "clear"), Nazwa ;", notePl = "Trzy operacje na całym magazynie.", noteEn = "Three whole-store operations."),
    GrammarRule(id = "gr14", nonterminal = "Nawigacja", production = "Nawigacja = "go", "to", Nazwa, ["(", Argumenty, ")"] | "go", "back" ;", notePl = "Cel nawigacji musi istnieć i przyjmować dokładnie tyle argumentów, ile podano.", noteEn = "The target must exist and take exactly the arguments given."),
    GrammarRule(id = "gr15", nonterminal = "Zwrot", production = "Zwrot = "return", [ Wyrazenie ] ;", notePl = "Funkcja bez zadeklarowanego typu zwracanego nie może użyć return.", noteEn = "A function without a declared return type cannot use return."),
    GrammarRule(id = "gr16", nonterminal = "Wywolanie", production = "Wywolanie = Nazwa, "(", [ Argumenty ], ")" ;", notePl = "Liczba argumentów musi zgadzać się z deklaracją funkcji.", noteEn = "Argument count must match the function declaration."),
    GrammarRule(id = "gr17", nonterminal = "Warunek", production = "Warunek = "if", Wyrazenie, Blok, [ "else", Blok ] ;", notePl = "Dopuszczalny jeden poziom else. Zagnieżdżanie przez kolejny if.", noteEn = "One else level. Nest with another if."),
    GrammarRule(id = "gr18", nonterminal = "Petla", production = "Petla = "for", Nazwa, "in", Wyrazenie, Blok ;", notePl = "Pętla istnieje w logice. W interfejsie listy są deklaratywne przez list i item.", noteEn = "Loops exist in logic. In UI, lists are declarative."),
    GrammarRule(id = "gr19", nonterminal = "ObslugaBledu", production = "ObslugaBledu = "try", Blok, "catch", Nazwa, Blok, [ "finally", Blok ] ;", notePl = "Operacja sieciowa bez catch to błąd AX5004.", noteEn = "A network call without catch is error AX5004."),
    GrammarRule(id = "gr20", nonterminal = "Zdarzenie", production = "Zdarzenie = "when", NazwaZdarzenia, Blok ;", notePl = "Dwanaście nazw zdarzeń. Nieznana nazwa to błąd AX3004.", noteEn = "Twelve event names. An unknown name is error AX3004."),
    GrammarRule(id = "gr21", nonterminal = "Element", production = "Element = Kontener | Tekst | Przycisk | Pole | Obraz | Wybor | Media | Odstep | WywolanieKomponentu ;", notePl = "Dziewięć rodzajów elementów interfejsu.", noteEn = "Nine UI element kinds."),
    GrammarRule(id = "gr22", nonterminal = "Kontener", production = "Kontener = ("column" | "row" | "grid" | "card" | "scroll"), { Akcesorium }, { Element } ;", notePl = "Pięć kontenerów. Akcesoria podaje się bezpośrednio pod kontenerem, przed dziećmi.", noteEn = "Five containers. Accessories go right under the container, before children."),
    GrammarRule(id = "gr23", nonterminal = "Lista", production = "Lista = "list", Zrodlo, "empty", Blok, "item", Nazwa, Blok ;", notePl = "Gałąź empty jest wymagana. Lista bez empty to błąd AX3006.", noteEn = "The empty branch is required. A list without it is error AX3006."),
    GrammarRule(id = "gr24", nonterminal = "Obraz", production = "Obraz = "image", Zrodlo, "alt", Tekst ;", notePl = "Obraz bez alt to błąd AX7001. Nie da się tego przeoczyć.", noteEn = "An image without alt is error AX7001. It cannot be overlooked."),
    GrammarRule(id = "gr25", nonterminal = "Pole", production = "Pole = "field", Nazwa, "label", Tekst, { Walidacja }, [ "error", Tekst ] ;", notePl = "Pole bez label to błąd AX7003.", noteEn = "A field without label is error AX7003."),
    GrammarRule(id = "gr26", nonterminal = "Przycisk", production = "Przycisk = "button", ( Tekst | "icon", Tekst ), [ "accessibility", "label", Tekst ], { "when", Zdarzenie } ;", notePl = "Przycisk ikonowy bez accessibility label to błąd AX7002.", noteEn = "An icon button without accessibility label is error AX7002."),
    GrammarRule(id = "gr27", nonterminal = "Walidacja", production = "Walidacja = "required" | "min", "length", Liczba | "max", "length", Liczba | "type", ("email" | "password" | "number") ;", notePl = "Walidacja jest deklaratywna, nie pisana ręcznie.", noteEn = "Validation is declarative, not hand-written."),
    GrammarRule(id = "gr28", nonterminal = "Magazyn", production = "Magazyn = "store", Nazwa, Klasa, { Klasa }, ("single" | "list"), Typ, "key", Tekst ;", notePl = "Klucz jest wymagany. Bez niego kompilator zgłasza AX4004.", noteEn = "The key is required. Without it the compiler reports AX4004."),
    GrammarRule(id = "gr29", nonterminal = "Klasa", production = "Klasa = "local" | "synced" | "encrypted" | "secure" | "cache" | "queue" ;", notePl = "Sekrety muszą trafić do secure. Inaczej AX6001.", noteEn = "Secrets must go to secure. Otherwise AX6001."),
    GrammarRule(id = "gr30", nonterminal = "Wyrazenie", production = "Wyrazenie = Literal | Sciezka | Wywolanie | Wyrazenie, Operator, Wyrazenie | "(", Wyrazenie, ")" ;", notePl = "Wyrażenia opisują wartości: literały, ścieżki do pól, wywołania funkcji i operacje.", noteEn = "Expressions describe values: literals, field paths, calls and operations.")
  ]
  save grammar

  set lexemes = [
    Lexeme(id = "lx1", kind = "Nazwa sekcji", pattern = "mała litera, potem litery i cyfry", example = "screen", notePl = "Słowo, które rozpoczyna sekcję. Zawsze z małej litery.", noteEn = "The word opening a section. Always lowercase."),
    Lexeme(id = "lx2", kind = "Nazwa typu", pattern = "wielka litera, potem litery i cyfry", example = "ChatMessage", notePl = "Nazwy modeli, enumów i komponentów piszemy z wielkiej litery.", noteEn = "Model, enum and component names start uppercase."),
    Lexeme(id = "lx3", kind = "Nazwa zmiennej", pattern = "mała litera, potem litery, cyfry, podkreślenie", example = "activeConversationId", notePl = "Nazwy pól, stanu i funkcji piszemy z małej litery.", noteEn = "Field, state and function names start lowercase."),
    Lexeme(id = "lx4", kind = "Tekst", pattern = "w cudzysłowie prostym", example = "\"Rozmowa\"", notePl = "Cudzysłów prosty, nie krzywy. Krzywy cudzysłów to błąd AX1002.", noteEn = "Straight quotes only. A curly quote is error AX1002."),
    Lexeme(id = "lx5", kind = "Liczba", pattern = "cyfry, opcjonalnie kropka i cyfry", example = "16", notePl = "Kropka jako separator dziesiętny. Przecinek nie jest akceptowany.", noteEn = "Dot as decimal separator. Comma is rejected."),
    Lexeme(id = "lx6", kind = "Flaga", pattern = "true albo false", example = "true", notePl = "Zawsze małymi literami. True to błąd AX1003.", noteEn = "Always lowercase. True is error AX1003."),
    Lexeme(id = "lx7", kind = "Pusta wartość", pattern = "none", example = "none", notePl = "Pusta wartość to none. null i nil to błąd AX1004.", noteEn = "Empty value is none. null and nil are error AX1004."),
    Lexeme(id = "lx8", kind = "Kolor", pattern = "krzyżyk i sześć znaków szesnastkowych", example = "#4F46E5", notePl = "Dopuszczalny zapis trójznakowy i ośmioznakowy z kanałem alfa.", noteEn = "Three and eight digit forms allowed, eight with alpha."),
    Lexeme(id = "lx9", kind = "Komentarz", pattern = "dwa ukośniki do końca linii", example = "// opis", notePl = "Komentarz jest pomijany przez parser i nie trafia do drzewa.", noteEn = "Comments are skipped by the parser."),
    Lexeme(id = "lx10", kind = "Wcięcie", pattern = "spacje albo tabulatory na początku linii", example = "    ", notePl = "Wcięcie jest znaczące. Określa przynależność do bloku.", noteEn = "Indentation is significant. It defines block membership.")
  ]
  save lexemes


// ============================================================================
// REGUŁY — każda ma opis dwujęzyczny, składnię, przykład poprawny,
// kontrprzykład błędny i kod błędu, który zgłosi kompilator.
//
// Ta sekcja jest korpusem uczącym: bot czyta regułę i od razu widzi,
// jak wygląda kod poprawny oraz co dokładnie jest błędem.
// ============================================================================

function loadRules()
  set rules = [
    RuleSet(
      id = "r01", number = "01",
      titlePl = "Sekcje pliku", titleEn = "File sections",
      rulePl = "Plik składa się z sekcji. Kolejność jest dowolna, ale zalecana to: app, theme, style, enum, data, store, global state, permission, api, function, component, screen, test.",
      ruleEn = "A file is made of sections. Order is free; recommended: app, theme, style, enum, data, store, global state, permission, api, function, component, screen, test.",
      syntax = "Sekcja = Naglowek, { LiniaTresci }",
      goodPl = "Poprawnie", goodEn = "Correct",
      goodCode = "app \"Notatnik\"\nversion \"1.0.0\"\nlanguage pl\nsupports ios android web\nentry Home\n\ndata Note\n  id Text\n  body Text\n\nscreen Home\n  title \"Notatnik\"",
      badCode = "Notatnik\n  version 1.0\n  data Note body Text",
      errorCode = "AX1001",
      errorName = "Nieznana deklaracja najwyższego poziomu",
      fixPl = "Każdą sekcję rozpocznij słowem kluczowym z listy trzynastu. Nazwa aplikacji musi być w cudzysłowie.",
      fixEn = "Start every section with one of the thirteen keywords. The app name must be quoted."
    ),
    RuleSet(
      id = "r02", number = "02",
      titlePl = "Wcięcie ma znaczenie", titleEn = "Indentation is significant",
      rulePl = "Blok należy do nagłówka o wyższym wcięciu. Tabulator ma szerokość dwóch spacji. Nie mieszaj tabulatorów ze spacjami w jednej linii.",
      ruleEn = "A block belongs to the header with higher indentation. A tab counts as two spaces. Do not mix tabs and spaces in one line.",
      syntax = "Wciecie = { Spacja | Tabulator }",
      goodPl = "Poprawnie — dwie spacje", goodEn = "Correct — two spaces",
      goodCode = "screen Home\n  title \"Start\"\n\n  column\n    gap 16\n    text \"Witaj\"",
      badCode = "screen Home\n\ttitle \"Start\"\n  column\n \t  gap 16",
      errorCode = "AX1005",
      errorName = "Mieszane wcięcie w jednej linii",
      fixPl = "Ustaw edytor na wcięcia dwoma spacjami. Tabulator zamień na dwie spacje.",
      fixEn = "Configure your editor for two-space indentation. Replace tabs with two spaces."
    ),
    RuleSet(
      id = "r03", number = "03",
      titlePl = "Nazwy pisane właściwą literą", titleEn = "Names use the right case",
      rulePl = "Sekcje, pola, stan i funkcje z małej litery. Modele, enumy i komponenty z wielkiej. Nazwa typu z małej litery to ostrzeżenie, nie błąd.",
      ruleEn = "Sections, fields, state and functions lowercase. Models, enums and components uppercase. A lowercase type name is a warning, not an error.",
      syntax = "NazwaTypu = WielkaLitera, { Litera | Cyfra }",
      goodPl = "Poprawnie", goodEn = "Correct",
      goodCode = "data ChatMessage\n  id Text\n  body Text\n\nfunction userCount() returns Number\n  return length(users)",
      badCode = "data chatMessage\n  id Text\n\nfunction UserCount() returns Number\n  return 0",
      errorCode = "AX2005",
      errorName = "Nazwa typu zapisana małą literą",
      fixPl = "Zmień pierwszą literę nazwy modelu, enuma i komponentu na wielką.",
      fixEn = "Upper-case the first letter of model, enum and component names."
    ),
    RuleSet(
      id = "r04", number = "04",
      titlePl = "Tekst w cudzysłowie prostym", titleEn = "Text in straight quotes",
      rulePl = "Tekst otaczamy prostym cudzysłowem. Krzywy cudzysłów z edytora tekstu jest błędem składni.",
      ruleEn = "Text is wrapped in straight quotes. A curly quote from a word processor is a syntax error.",
      syntax = "Tekst = \"\"\", { Znak }, \"\"\"",
      goodPl = "Poprawnie", goodEn = "Correct",
      goodCode = "text \"Rozmowa\"\n  style title\n\nbutton \"Wyślij\"\n  style buttonPrimary",
      badCode = "text „Rozmowa” \n  style title",
      errorCode = "AX1002",
      errorName = "Niepoprawny tekst — krzywy cudzysłów",
      fixPl = "Zamień „ i ” na prosty cudzysłów. W edytorze wyłącz inteligentne cudzysłowy.",
      fixEn = "Replace curly quotes with straight quotes. Disable smart quotes in your editor."
    ),
    RuleSet(
      id = "r05", number = "05",
      titlePl = "Flagi i pusta wartość", titleEn = "Booleans and empty value",
      rulePl = "Flaga to true albo false, zawsze małymi literami. Pusta wartość to none. Pisownia True, False, null i nil to błędy.",
      ruleEn = "A boolean is true or false, always lowercase. Empty value is none. True, False, null and nil are errors.",
      syntax = "Flaga = \"true\" | \"false\" ; Pusta = \"none\"",
      goodPl = "Poprawnie", goodEn = "Correct",
      goodCode = "global state isOnline Boolean = true\nglobal state draft Text = \"\"\nglobal state user Text = none",
      badCode = "global state isOnline Boolean = True\nglobal state user Text = null",
      errorCode = "AX1003",
      errorName = "Niepoprawna flaga lub pusta wartość",
      fixPl = "Zapisz true, false i none małymi literami.",
      fixEn = "Write true, false and none in lowercase."
    ),
    RuleSet(
      id = "r06", number = "06",
      titlePl = "Stan lokalny i globalny", titleEn = "Local and global state",
      rulePl = "Stan lokalny deklarujemy w ekranie słowem state. Stan globalny słowami global state i wymaga wartości początkowej.",
      ruleEn = "Local state is declared with state inside a screen. Global state uses global state and requires an initial value.",
      syntax = "Stan = \"state\", Nazwa, Typ, [ \"=\", Wyrazenie ] ; StanGlobalny = \"global\", \"state\", Nazwa, Typ, \"=\", Wyrazenie",
      goodPl = "Poprawnie", goodEn = "Correct",
      goodCode = "global state isSignedIn Boolean = false\n\nscreen Login\n  title \"Wejdź\"\n\n  state email Text = \"\"\n  state isBusy Boolean = false",
      badCode = "global state isSignedIn Boolean\n\nscreen Login\n  title \"Wejdź\"\n\n  email Text = \"\"",
      errorCode = "AX4002",
      errorName = "Stan globalny bez wartości początkowej",
      fixPl = "Dopisz wartość po znaku równości. Stan lokalny zadeklaruj słowem state.",
      fixEn = "Add a value after the equals sign. Declare local state with the state keyword."
    ),
    RuleSet(
      id = "r07", number = "07",
      titlePl = "Typ opcjonalny", titleEn = "Optional type",
      rulePl = "Znak zapytania po typie oznacza, że wartość może być pusta. Pole opcjonalne można pominąć przy tworzeniu modelu.",
      ruleEn = "A question mark after a type marks an optional value. An optional field may be omitted when building a model.",
      syntax = "Typ = Nazwa, [ \"?\" ]",
      goodPl = "Poprawnie", goodEn = "Correct",
      goodCode = "data User\n  id Text\n  displayName Text\n  avatarUrl Text?\n  bio Text?",
      badCode = "data User\n  id Text\n  displayName Text\n  avatarUrl Text empty",
      errorCode = "AX2002",
      errorName = "Nieznany typ pola",
      fixPl = "Opcjonalność oznaczamy znakiem zapytania po nazwie typu, nie słowem.",
      fixEn = "Mark optionality with a question mark after the type name, not with a word."
    ),
    RuleSet(
      id = "r08", number = "08",
      titlePl = "Magazyn wymaga klucza", titleEn = "A store requires a key",
      rulePl = "Każdy magazyn deklaruje zawartość i klucz. Klucz zawiera wersję, żeby zmiana kształtu danych nie psuła zapisanych danych.",
      ruleEn = "Every store declares its content and a key. The key carries a version so a data shape change does not break saved data.",
      syntax = "Magazyn = \"store\", Nazwa, Klasa, (\"single\" | \"list\"), Typ, \"key\", Tekst",
      goodPl = "Poprawnie", goodEn = "Correct",
      goodCode = "store messages local encrypted\n  list Message\n  key \"app.messages.v2\"",
      badCode = "store messages local\n  list Message",
      errorCode = "AX4004",
      errorName = "Magazyn bez klucza",
      fixPl = "Dopisz linię key z nazwą i numerem wersji, na przykład key \"app.messages.v1\".",
      fixEn = "Add a key line with a name and version, for example key \"app.messages.v1\"."
    ),
    RuleSet(
      id = "r09", number = "09",
      titlePl = "Sekrety tylko do magazynu secure", titleEn = "Secrets only in a secure store",
      rulePl = "Klucze API, tokeny i dane biometryczne trafiają wyłącznie do magazynu klasy secure. Zapis sekretu w magazynie lokalnym to błąd.",
      ruleEn = "API keys, tokens and biometric data go only to a secure store. Writing a secret to a local store is an error.",
      syntax = "Klasa = \"secure\"",
      goodPl = "Poprawnie", goodEn = "Correct",
      goodCode = "store providerKeys secure\n  list Text\n  key \"app.keys.v1\"",
      badCode = "store providerKeys local\n  list Text\n  key \"app.keys.v1\"",
      errorCode = "AX6001",
      errorName = "Sekret w magazynie bez szyfrowania",
      fixPl = "Zmień klasę magazynu na secure. Magazyn secure szyfruje zawartość i nie trafia do kopii zapasowej.",
      fixEn = "Change the store class to secure. A secure store encrypts its content and is excluded from backups."
    ),
    RuleSet(
      id = "r10", number = "10",
      titlePl = "Obraz wymaga opisu", titleEn = "An image requires alt text",
      rulePl = "Każdy obraz ma tekst alternatywny. Bez niego osoba niewidoma nie wie, co jest na ekranie. To błąd, nie ostrzeżenie.",
      ruleEn = "Every image has alt text. Without it a blind user has no idea what is on screen. This is an error, not a warning.",
      syntax = "Obraz = \"image\", Zrodlo, \"alt\", Tekst",
      goodPl = "Poprawnie", goodEn = "Correct",
      goodCode = "image user.avatarUrl\n  width 96\n  height 96\n  alt \"Zdjęcie profilowe użytkownika\"",
      badCode = "image user.avatarUrl\n  width 96\n  height 96",
      errorCode = "AX7001",
      errorName = "Obraz bez tekstu alternatywnego",
      fixPl = "Dopisz linię alt z krótkim opisem tego, co widać na obrazie.",
      fixEn = "Add an alt line with a short description of what the image shows."
    ),
    RuleSet(
      id = "r11", number = "11",
      titlePl = "Pole wymaga etykiety", titleEn = "A field requires a label",
      rulePl = "Każde pole formularza ma etykietę. Etykieta jest czytana przez czytnik ekranu i widoczna nad polem.",
      ruleEn = "Every form field has a label. The label is read by screen readers and shown above the field.",
      syntax = "Pole = \"field\", Nazwa, \"label\", Tekst, { Walidacja }",
      goodPl = "Poprawnie", goodEn = "Correct",
      goodCode = "field email\n  label \"E-mail\"\n  type email\n  required\n  error \"Podaj poprawny adres e-mail.\"",
      badCode = "field email\n  type email\n  required",
      errorCode = "AX7003",
      errorName = "Pole bez etykiety",
      fixPl = "Dopisz linię label z nazwą pola widoczną dla użytkownika.",
      fixEn = "Add a label line with the user-visible field name."
    ),
    RuleSet(
      id = "r12", number = "12",
      titlePl = "Przycisk ikonowy wymaga nazwy", titleEn = "An icon button requires a name",
      rulePl = "Przycisk bez widocznego tekstu musi mieć accessibility label. Inaczej czytnik ekranu ogłosi tylko słowo przycisk.",
      ruleEn = "A button with no visible text must have an accessibility label. Otherwise screen readers announce only the word button.",
      syntax = "Przycisk = \"button\", \"icon\", Tekst, \"accessibility\", \"label\", Tekst",
      goodPl = "Poprawnie", goodEn = "Correct",
      goodCode = "button icon \"mic\"\n  accessibility label \"Nagraj wiadomość głosową\"\n  when tapped\n    startRecording()",
      badCode = "button icon \"mic\"\n  when tapped\n    startRecording()",
      errorCode = "AX7002",
      errorName = "Przycisk ikonowy bez etykiety dostępności",
      fixPl = "Dopisz linię accessibility label z opisem akcji, którą przycisk wykonuje.",
      fixEn = "Add an accessibility label line describing the action the button performs."
    ),
    RuleSet(
      id = "r13", number = "13",
      titlePl = "Lista wymaga gałęzi empty", titleEn = "A list requires an empty branch",
      rulePl = "Lista deklaruje, co pokazać, gdy jest pusta. Bez tego przy braku danych użytkownik widzi pusty ekran i nie wie, czy coś się zepsuło.",
      ruleEn = "A list declares what to show when it is empty. Without it an empty dataset leaves a blank screen and the user cannot tell whether something broke.",
      syntax = "Lista = \"list\", Zrodlo, \"empty\", Blok, \"item\", Nazwa, Blok",
      goodPl = "Poprawnie", goodEn = "Correct",
      goodCode = "list messages\n  empty\n    text \"Brak wiadomości\"\n      style caption\n  item message\n    text message.body",
      badCode = "list messages\n  item message\n    text message.body",
      errorCode = "AX3006",
      errorName = "Lista bez gałęzi empty",
      fixPl = "Dopisz blok empty z krótkim komunikatem przed blokiem item.",
      fixEn = "Add an empty block with a short message before the item block."
    ),
    RuleSet(
      id = "r14", number = "14",
      titlePl = "Nawigacja na istniejący ekran", titleEn = "Navigate to an existing screen",
      rulePl = "Cel nawigacji musi istnieć i przyjmować dokładnie tyle argumentów, ile podano. Literówka w nazwie to błąd kompilacji.",
      ruleEn = "The navigation target must exist and take exactly the arguments given. A typo in the name is a compile error.",
      syntax = "Nawigacja = \"go\", \"to\", Nazwa, [ \"(\", Argumenty, \")\" ]",
      goodPl = "Poprawnie", goodEn = "Correct",
      goodCode = "screen Home\n  title \"Start\"\n\n  button \"Otwórz profil\"\n    accessibility label \"Otwórz profil\"\n    when tapped\n      go to Home",
      badCode = "screen Home\n  title \"Start\"\n\n  button \"Otwórz profil\"\n    accessibility label \"Otwórz profil\"\n    when tapped\n      go to Home",
      errorCode = "AX8001",
      errorName = "Nawigacja do nieistniejącego ekranu",
      fixPl = "Sprawdź nazwę celu. Kompilator poda, które ekrany istnieją w pliku.",
      fixEn = "Check the target name. The compiler lists the screens that exist in the file."
    ),
    RuleSet(
      id = "r15", number = "15",
      titlePl = "Sieć wymaga limitu, ponowień i obsługi błędu", titleEn = "Network needs a timeout, retries and error handling",
      rulePl = "Warstwa api deklaruje limit czasu i liczbę ponowień. Wywołanie sieciowe w funkcji musi być objęte blokiem try z catch.",
      ruleEn = "An api layer declares timeout and retry count. A network call in a function must be wrapped in a try block with catch.",
      syntax = "ObslugaBledu = \"try\", Blok, \"catch\", Nazwa, Blok",
      goodPl = "Poprawnie", goodEn = "Correct",
      goodCode = "function loadTasks()\n  try\n    set result = TasksApi.list()\n    set tasks = result\n  catch error\n    showError(error.message)\n\napi TasksApi\n  base \"https://api.example.com\"\n  timeout 15000\n  retry 3",
      badCode = "function loadTasks()\n  set result = TasksApi.list()\n\napi TasksApi\n  base \"https://api.example.com\"",
      errorCode = "AX5004",
      errorName = "Blok try bez catch albo wywołanie sieci bez osłony",
      fixPl = "Otocz wywołanie blokiem try z catch error. Dopisz timeout i retry w warstwie api.",
      fixEn = "Wrap the call in try with catch error. Add timeout and retry to the api layer."
    ),
    RuleSet(
      id = "r16", number = "16",
      titlePl = "Adres bazowy przez HTTPS", titleEn = "Base address over HTTPS",
      rulePl = "Warstwa api może używać wyłącznie adresu z HTTPS. Połączenie nieszyfrowane to błąd bezpieczeństwa.",
      ruleEn = "An api layer may use an HTTPS address only. An unencrypted connection is a security error.",
      syntax = "base \"https://...\"",
      goodPl = "Poprawnie", goodEn = "Correct",
      goodCode = "api NotesApi\n  base \"https://api.example.com\"\n  timeout 15000\n  retry 2",
      badCode = "api NotesApi\n  base \"http://api.example.com\"\n  timeout 15000\n  retry 2",
      errorCode = "AX6002",
      errorName = "Warstwa api używa HTTP",
      fixPl = "Zmień adres na https. Jeśli serwer nie obsługuje HTTPS, to nie jest gotowy do użytku.",
      fixEn = "Change the address to https. If the server does not support HTTPS it is not ready for use."
    ),
    RuleSet(
      id = "r17", number = "17",
      titlePl = "Nawigacja musi mieć odpowiednik przyciskiem", titleEn = "Every gesture needs a button alternative",
      rulePl = "Każde działanie wywołane gestem musi mieć odpowiednik w postaci przycisku. Inaczej osoba bez sprawnej dłoni nie wykona tej akcji.",
      ruleEn = "Every gesture-driven action needs a button alternative. Otherwise someone without hand dexterity cannot perform it.",
      syntax = "Zasada dostepnosci",
      goodPl = "Poprawnie", goodEn = "Correct",
      goodCode = "column\n  gap 12\n\n  button \"Przesuń dalej\"\n    style buttonPrimary\n    accessibility label \"Przejdź do następnego elementu\"\n    when tapped\n      nextItem()",
      badCode = "column\n  gap 12\n\n  swipeable\n    when swiped left\n      nextItem()",
      errorCode = "AX7006",
      errorName = "Gest bez alternatywy przyciskowej",
      fixPl = "Dopisz przycisk wykonujący tę samą akcję co gest.",
      fixEn = "Add a button performing the same action as the gesture."
    ),
    RuleSet(
      id = "r18", number = "18",
      titlePl = "Tempo i animacja nie mogą być jedynym nośnikiem", titleEn = "Timing and motion cannot be the only carrier",
      rulePl = "Informacja przekazana animacją albo tętnem musi mieć odpowiednik w tekście, dźwięku albo wibracji. Animacja respektuje ustawienie ograniczenia ruchu.",
      ruleEn = "Information carried by animation or a pulse must have a text, sound or vibration counterpart. Animation respects the reduced-motion setting.",
      syntax = "Zasada dostepnosci",
      goodPl = "Poprawnie", goodEn = "Correct",
      goodCode = "card\n  column\n    gap 8\n    text \"Łączenie…\"\n      style caption\n    text \"Trwa próba połączenia z serwerem.\"\n      style caption",
      badCode = "card\n  animate appear\n    duration 4000ms\n\n  text \"\"\n    style caption",
      errorCode = "AX7007",
      errorName = "Informacja tylko w animacji",
      fixPl = "Dodaj opis tekstowy obok animacji. Nie usuwaj animacji, uzupełnij ją.",
      fixEn = "Add a text description next to the animation. Do not remove the animation, complement it."
    ),
    RuleSet(
      id = "r19", number = "19",
      titlePl = "Wynik AI zawsze oznaczony", titleEn = "AI output is always marked",
      rulePl = "Treść wygenerowana przez model jest jawnie oznaczona. Rozpoznany znak, transkrypcja i tłumaczenie wymagają potwierdzenia przez człowieka przed użyciem.",
      ruleEn = "Model-generated content is explicitly marked. A recognised sign, a transcript and a translation require human confirmation before use.",
      syntax = "Zasada odpowiedzialnosci",
      goodPl = "Poprawnie", goodEn = "Correct",
      goodCode = "card\n  column\n    gap 8\n    text \"AI\"\n      style badgeAi\n    text \"Treść wygenerowana przez model. Sprawdź przed użyciem.\"\n      style caption",
      badCode = "card\n  column\n    gap 8\n    text generatedAnswer\n      style body",
      errorCode = "AX6003",
      errorName = "Treść AI bez oznaczenia",
      fixPl = "Dodaj widoczną etykietę informującą, że treść pochodzi z modelu.",
      fixEn = "Add a visible label stating the content comes from a model."
    ),
    RuleSet(
      id = "r20", number = "20",
      titlePl = "Kontrast i obszar dotyku", titleEn = "Contrast and touch area",
      rulePl = "Kontrast tekstu wynosi co najmniej 4,5 do 1, a elementy interaktywne mają co najmniej 48 na 48 punktów. Rozmiar tekstu skaluje się do trzystu procent.",
      ruleEn = "Text contrast is at least 4.5 to 1, interactive elements are at least 48 by 48 points, and text scales up to three hundred percent.",
      syntax = "Zasada dostepnosci",
      goodPl = "Poprawnie", goodEn = "Correct",
      goodCode = "button \"Wyślij\"\n  style buttonPrimary\n  height 52\n  accessibility label \"Wyślij wiadomość\"\n  when tapped\n    send()",
      badCode = "button \"Wyślij\"\n  height 24\n  color #DDDDDD\n  background #FFFFFF\n  accessibility label \"Wyślij wiadomość\"\n  when tapped\n    send()",
      errorCode = "AX7004",
      errorName = "Zbyt niski kontrast albo zbyt mały obszar dotyku",
      fixPl = "Podnieś kontrast do co najmniej 4,5 do 1 i zwiększ wysokość elementu do 48 punktów.",
      fixEn = "Raise contrast to at least 4.5 to 1 and increase the element height to 48 points."
    )
  ]
  save rules


