// KATALOG BŁĘDÓW — każdy kod z przyczyną i poprawką, dwujęzycznie
// ============================================================================

function loadErrors()
  set errors = [
    ErrorRow(id = "e1", code = "AX1001", rangePl = "AX1000–AX1999 Składnia", rangeEn = "AX1000–AX1999 Syntax",
      sample = "Notatnik\n  version 1.0",
      causePl = "Linia najwyższego poziomu nie zaczyna się od słowa kluczowego sekcji.", causeEn = "The top-level line does not start with a section keyword.",
      fixPl = "Rozpocznij sekcję jednym z trzynastu słów: app, theme, style, enum, data, store, global state, permission, api, function, component, screen, test.", fixEn = "Start the section with one of thirteen keywords: app, theme, style, enum, data, store, global state, permission, api, function, component, screen, test."),
    ErrorRow(id = "e2", code = "AX1002", rangePl = "AX1000–AX1999 Składnia", rangeEn = "AX1000–AX1999 Syntax",
      sample = "text „Witaj”",
      causePl = "Tekst otoczony krzywym cudzysłowem z edytora tekstu.", causeEn = "Text wrapped in curly quotes from a word processor.",
      fixPl = "Użyj prostego cudzysłowu. Wyłącz inteligentne cudzysłowy w edytorze.", fixEn = "Use straight quotes. Disable smart quotes in your editor."),
    ErrorRow(id = "e3", code = "AX1003", rangePl = "AX1000–AX1999 Składnia", rangeEn = "AX1000–AX1999 Syntax",
      sample = "isOnline Boolean = True",
      causePl = "Flaga zapisana wielką literą albo pusta wartość zapisana jako null lub nil.", causeEn = "A boolean written uppercase, or an empty value written as null or nil.",
      fixPl = "Zapisz true, false i none małymi literami.", fixEn = "Write true, false and none in lowercase."),
    ErrorRow(id = "e4", code = "AX1005", rangePl = "AX1000–AX1999 Składnia", rangeEn = "AX1000–AX1999 Syntax",
      sample = "\ttitle \"Start\"",
      causePl = "Tabulator i spacje w tym samym wcięciu.", causeEn = "Tabs and spaces in the same indentation.",
      fixPl = "Zamień tabulator na dwie spacje. Ustaw edytor na wcięcia spacjami.", fixEn = "Replace the tab with two spaces. Configure your editor for space indentation."),
    ErrorRow(id = "e5", code = "AX2002", rangePl = "AX2000–AX2999 Typy", rangeEn = "AX2000–AX2999 Types",
      sample = "data User\n  avatar Text empty",
      causePl = "Pole ma typ, którego nie ma wśród wbudowanych ani zadeklarowanych w pliku.", causeEn = "A field uses a type that is neither built-in nor declared in the file.",
      fixPl = "Użyj typu wbudowanego albo zadeklaruj model blokiem data. Opcjonalność oznacz znakiem zapytania.", fixEn = "Use a built-in type or declare the model with a data block. Mark optionality with a question mark."),
    ErrorRow(id = "e6", code = "AX2005", rangePl = "AX2000–AX2999 Typy", rangeEn = "AX2000–AX2999 Types",
      sample = "data chatMessage",
      causePl = "Nazwa modelu, enuma albo komponentu zapisana małą literą.", causeEn = "A model, enum or component name written lowercase.",
      fixPl = "Zmień pierwszą literę na wielką. To ostrzeżenie, nie błąd — kod się skompiluje.", fixEn = "Upper-case the first letter. This is a warning, not an error — the code still compiles."),
    ErrorRow(id = "e7", code = "AX3004", rangePl = "AX3000–AX3999 Interfejs", rangeEn = "AX3000–AX3999 Interface",
      sample = "when touched",
      causePl = "Nazwa zdarzenia nie należy do listy dwunastu rozpoznawanych.", causeEn = "The event name is not one of the twelve recognised names.",
      fixPl = "Użyj jednej z nazw: tapped, changed value, screen appears, screen disappears, app launches, valid, invalid, error, online, offline, permission granted, permission denied.", fixEn = "Use one of: tapped, changed value, screen appears, screen disappears, app launches, valid, invalid, error, online, offline, permission granted, permission denied."),
    ErrorRow(id = "e8", code = "AX3006", rangePl = "AX3000–AX3999 Interfejs", rangeEn = "AX3000–AX3999 Interface",
      sample = "list messages\n  item message",
      causePl = "Lista nie deklaruje, co pokazać przy braku danych.", causeEn = "The list does not declare what to show when there is no data.",
      fixPl = "Dopisz blok empty przed blokiem item.", fixEn = "Add an empty block before the item block."),
    ErrorRow(id = "e9", code = "AX4002", rangePl = "AX4000–AX4999 Stan", rangeEn = "AX4000–AX4999 State",
      sample = "global state isSignedIn Boolean",
      causePl = "Stan globalny bez wartości początkowej.", causeEn = "Global state without an initial value.",
      fixPl = "Dopisz wartość po znaku równości.", fixEn = "Add a value after the equals sign."),
    ErrorRow(id = "e10", code = "AX4004", rangePl = "AX4000–AX4999 Stan", rangeEn = "AX4000–AX4999 State",
      sample = "store messages local\n  list Message",
      causePl = "Magazyn nie deklaruje klucza przechowywania.", causeEn = "The store does not declare a storage key.",
      fixPl = "Dopisz linię key z nazwą i numerem wersji.", fixEn = "Add a key line with a name and a version number."),
    ErrorRow(id = "e11", code = "AX5004", rangePl = "AX5000–AX5999 Sieć", rangeEn = "AX5000–AX5999 Network",
      sample = "set result = TasksApi.list()",
      causePl = "Wywołanie sieciowe bez bloku try z catch, albo blok try bez catch.", causeEn = "A network call with no try/catch, or a try block with no catch.",
      fixPl = "Otocz wywołanie blokiem try z catch error i obsłuż komunikat błędu.", fixEn = "Wrap the call in try with catch error and handle the error message."),
    ErrorRow(id = "e12", code = "AX5005", rangePl = "AX5000–AX5999 Sieć", rangeEn = "AX5000–AX5999 Network",
      sample = "api TasksApi\n  base \"https://api.example.com\"",
      causePl = "Warstwa api nie deklaruje limitu czasu i liczby ponowień.", causeEn = "The api layer declares neither a timeout nor a retry count.",
      fixPl = "Dopisz timeout i retry. Wartości orientacyjne: 15000 milisekund i 3 próby.", fixEn = "Add timeout and retry. Sensible values: 15000 milliseconds and 3 attempts."),
    ErrorRow(id = "e13", code = "AX6001", rangePl = "AX6000–AX6999 Bezpieczeństwo", rangeEn = "AX6000–AX6999 Security",
      sample = "store providerKeys local",
      causePl = "Magazyn o nazwie sugerującej sekret nie jest klasy secure ani encrypted.", causeEn = "A store whose name suggests a secret is neither secure nor encrypted.",
      fixPl = "Zmień klasę na secure. Taki magazyn szyfruje zawartość i nie trafia do kopii zapasowej.", fixEn = "Change the class to secure. Such a store encrypts its content and is excluded from backups."),
    ErrorRow(id = "e14", code = "AX6002", rangePl = "AX6000–AX6999 Bezpieczeństwo", rangeEn = "AX6000–AX6999 Security",
      sample = "base \"http://api.example.com\"",
      causePl = "Adres bazowy warstwy api nie używa HTTPS.", causeEn = "The api layer base address does not use HTTPS.",
      fixPl = "Zmień adres na https. Serwer bez HTTPS nie jest gotowy do użytku.", fixEn = "Change the address to https. A server without HTTPS is not ready for use."),
    ErrorRow(id = "e15", code = "AX7001", rangePl = "AX7000–AX7999 Dostępność", rangeEn = "AX7000–AX7999 Accessibility",
      sample = "image user.avatarUrl",
      causePl = "Obraz bez tekstu alternatywnego.", causeEn = "An image with no alt text.",
      fixPl = "Dopisz linię alt z krótkim opisem tego, co widać.", fixEn = "Add an alt line with a short description of what is visible."),
    ErrorRow(id = "e16", code = "AX7002", rangePl = "AX7000–AX7999 Dostępność", rangeEn = "AX7000–AX7999 Accessibility",
      sample = "button icon \"mic\"",
      causePl = "Przycisk bez widocznego tekstu nie ma etykiety dostępności.", causeEn = "A button with no visible text has no accessibility label.",
      fixPl = "Dopisz linię accessibility label z opisem akcji.", fixEn = "Add an accessibility label line describing the action."),
    ErrorRow(id = "e17", code = "AX7003", rangePl = "AX7000–AX7999 Dostępność", rangeEn = "AX7000–AX7999 Accessibility",
      sample = "field email",
      causePl = "Pole formularza bez etykiety.", causeEn = "A form field with no label.",
      fixPl = "Dopisz linię label z nazwą pola widoczną dla użytkownika.", fixEn = "Add a label line with the user-visible field name."),
    ErrorRow(id = "e18", code = "AX7004", rangePl = "AX7000–AX7999 Dostępność", rangeEn = "AX7000–AX7999 Accessibility",
      sample = "color #DDDDDD na tle #FFFFFF",
      causePl = "Kontrast tekstu poniżej 4,5 do 1 albo obszar dotyku mniejszy niż 48 punktów.", causeEn = "Text contrast below 4.5 to 1, or a touch area smaller than 48 points.",
      fixPl = "Podnieś kontrast i zwiększ wysokość elementu interaktywnego do 48 punktów. To ostrzeżenie z propozycją gotowej wartości.", fixEn = "Raise contrast and increase the interactive element height to 48 points. This is a warning with a suggested value."),
    ErrorRow(id = "e19", code = "AX7006", rangePl = "AX7000–AX7999 Dostępność", rangeEn = "AX7000–AX7999 Accessibility",
      sample = "when swiped left\n  nextItem()",
      causePl = "Akcja dostępna wyłącznie gestem, bez odpowiednika przyciskiem.", causeEn = "An action available only by gesture, with no button alternative.",
      fixPl = "Dopisz przycisk wykonujący tę samą akcję.", fixEn = "Add a button performing the same action."),
    ErrorRow(id = "e20", code = "AX8001", rangePl = "AX8000–AX8999 Platforma", rangeEn = "AX8000–AX8999 Platform",
      sample = "nawigacja do ekranu, którego nie ma w pliku",
      causePl = "Cel nawigacji nie istnieje w pliku albo przyjmuje inną liczbę argumentów.", causeEn = "The navigation target does not exist in the file, or takes a different number of arguments.",
      fixPl = "Popraw nazwę albo dodaj brakujący ekran. Kompilator wypisze dostępne cele.", fixEn = "Fix the name or add the missing screen. The compiler lists available targets."),
    ErrorRow(id = "e21", code = "AX2001", rangePl = "AX2000–AX2999 Typy", rangeEn = "AX2000–AX2999 Types",
      sample = "state count Text = 0",
      causePl = "Wartość początkowa nie pasuje do zadeklarowanego typu.", causeEn = "The initial value does not match the declared type.",
      fixPl = "Zmień typ na Number albo wartość na tekst w cudzysłowie.", fixEn = "Change the type to Number or the value to a quoted string."),
    ErrorRow(id = "e22", code = "AX2003", rangePl = "AX2000–AX2999 Typy", rangeEn = "AX2000–AX2999 Types",
      sample = "function add(a Number, b Number) returns Number",
      causePl = "Funkcja deklaruje typ zwracany, ale żadna ścieżka nie kończy się instrukcją return.", causeEn = "The function declares a return type but no path ends with a return statement.",
      fixPl = "Dopisz return na końcu funkcji i we wszystkich gałęziach warunków.", fixEn = "Add a return at the end of the function and in every branch."),
    ErrorRow(id = "e23", code = "AX3002", rangePl = "AX3000–AX3999 Interfejs", rangeEn = "AX3000–AX3999 Interface",
      sample = "screen Home\n  column",
      causePl = "Ekran nie deklaruje tytułu. Tytuł jest ogłaszany przez czytnik ekranu przy wejściu.", causeEn = "The screen declares no title. The title is announced by screen readers on entry.",
      fixPl = "Dopisz linię title z nazwą ekranu.", fixEn = "Add a title line with the screen name."),
    ErrorRow(id = "e24", code = "AX4003", rangePl = "AX4000–AX4999 Stan", rangeEn = "AX4000–AX4999 State",
      sample = "state draft Text = \"\"\nstate draft Text = \"x\"",
      causePl = "Ten sam stan zadeklarowany dwa razy na jednym ekranie.", causeEn = "The same state declared twice on one screen.",
      fixPl = "Usuń jedną z deklaracji.", fixEn = "Remove one of the declarations."),
    ErrorRow(id = "e25", code = "AX9001", rangePl = "AX9000–AX9999 Wydajność", rangeEn = "AX9000–AX9999 Performance",
      sample = "list items\n  item item\n    list items\n      item inner",
      causePl = "Zbyt głębokie zagnieżdżenie list albo powtarzalne obliczenia wewnątrz pętli interfejsu.", causeEn = "Lists nested too deeply, or repeated computation inside a UI loop.",
      fixPl = "Wynieś obliczenie przed listę i zapisz wynik w stanie. Ogranicz zagnieżdżenie do dwóch poziomów.", fixEn = "Hoist the computation before the list and store the result in state. Limit nesting to two levels.")
  ]
  save errors


// ============================================================================
// PUŁAPKI — miejsca, w których model myli się najczęściej
//
// Każda pułapka ma zapis błędny, zapis poprawny i wyjaśnienie dlaczego.
// Ta sekcja jest instrukcją dla modelu: czego nie robić i co robić zamiast.
// ============================================================================

function loadTraps()
  set traps = [
    TrapRow(id = "t1",
      trapPl = "Dodawanie nawiasów klamrowych wokół bloków", trapEn = "Adding curly braces around blocks",
      wrongCode = "screen Home {\n  title \"Start\"\n}",
      rightCode = "screen Home\n  title \"Start\"",
      whyPl = "AXCode używa wcięcia, nie nawiasów. Nawias klamrowy w linii to błąd AX1001.", whyEn = "AXCode uses indentation, not braces. A brace in a line is error AX1001."),
    TrapRow(id = "t2",
      trapPl = "Kończenie linii średnikiem", trapEn = "Ending lines with a semicolon",
      wrongCode = "set draft = \"\";",
      rightCode = "set draft = \"\"",
      whyPl = "Średnik jest niedozwolony. Nowa linia kończy instrukcję.", whyEn = "A semicolon is not allowed. A newline ends the statement."),
    TrapRow(id = "t3",
      trapPl = "Używanie znaku równości do porównania", trapEn = "Using a single equals sign for comparison",
      wrongCode = "if mode = \"fast\"",
      rightCode = "if mode is \"fast\"",
      whyPl = "Porównanie zapisujemy słowem is. Słowo is not oznacza nierówność.", whyEn = "Comparison uses the word is. The word is not means inequality."),
    TrapRow(id = "t4",
      trapPl = "Mieszanie listy deklaratywnej z pętlą", trapEn = "Mixing a declarative list with a loop",
      wrongCode = "list\n  for message in messages\n    text message.body",
      rightCode = "list messages\n  empty\n    text \"Brak\"\n  item message\n    text message.body",
      whyPl = "W interfejsie lista ma własną składnię z gałęziami empty i item. Pętla należy do logiki.", whyEn = "In UI a list has its own syntax with empty and item branches. Loops belong to logic."),
    TrapRow(id = "t5",
      trapPl = "Pomijanie gałęzi empty, bo dane zawsze są", trapEn = "Skipping the empty branch because data always exists",
      wrongCode = "list tasks\n  item task\n    text task.title",
      rightCode = "list tasks\n  empty\n    text \"Brak zadań\"\n      style caption\n  item task\n    text task.title",
      whyPl = "Dane bywają puste: pierwsze uruchomienie, wyczyszczony magazyn, błąd sieci. Kompilator tego pilnuje.", whyEn = "Data is sometimes empty: first launch, cleared store, network failure. The compiler enforces this."),
    TrapRow(id = "t6",
      trapPl = "Obraz bez opisu, gdy jest dekoracyjny", trapEn = "An image without alt when it is decorative",
      wrongCode = "image \"hero.png\"\n  width 200",
      rightCode = "image \"hero.png\"\n  width 200\n  alt \"Ilustracja pokazująca trzy osoby rozmawiające migowo\"",
      whyPl = "Nie ma obrazów dekoracyjnych w rozumieniu kompilatora. Jeśli naprawdę nic nie wnosi, opisz to w alt.", whyEn = "There are no decorative images as far as the compiler is concerned. If it truly adds nothing, say so in alt."),
    TrapRow(id = "t7",
      trapPl = "Sekret w magazynie lokalnym", trapEn = "A secret in a local store",
      wrongCode = "store apiKeys local\n  list Text\n  key \"a.v1\"",
      rightCode = "store apiKeys secure\n  list Text\n  key \"a.v1\"",
      whyPl = "Magazyn lokalny jest czytelny dla systemu i trafia do kopii zapasowej. Klucz API musi być w secure.", whyEn = "A local store is readable by the system and included in backups. An API key must live in secure."),
    TrapRow(id = "t8",
      trapPl = "Zapominanie o wartości początkowej stanu globalnego", trapEn = "Forgetting the initial value of global state",
      wrongCode = "global state isOnline Boolean",
      rightCode = "global state isOnline Boolean = true",
      whyPl = "Stan globalny istnieje od startu aplikacji, więc musi mieć wartość, zanim cokolwiek się wydarzy.", whyEn = "Global state exists from app launch, so it must have a value before anything happens."),
    TrapRow(id = "t9",
      trapPl = "Wywołanie sieci bez obsługi błędu", trapEn = "A network call with no error handling",
      wrongCode = "function load()\n  set data = Api.list()",
      rightCode = "function load()\n  try\n    set data = Api.list()\n  catch error\n    showError(error.message)",
      whyPl = "Sieć zawodzi. Bez catch użytkownik nie dowie się, że coś poszło nie tak, a aplikacja zostanie w stanie zawieszenia.", whyEn = "Networks fail. Without catch the user never learns something went wrong and the app stays in a stuck state."),
    TrapRow(id = "t10",
      trapPl = "Cudzysłów krzywy zamiast prostego", trapEn = "A curly quote instead of a straight one",
      wrongCode = "text „Witaj”",
      rightCode = "text \"Witaj\"",
      whyPl = "Krzywy cudzysłów wygląda niemal identycznie, a parser go nie rozpoznaje jako ogranicznika tekstu.", whyEn = "A curly quote looks almost identical, and the parser does not recognise it as a text delimiter."),
    TrapRow(id = "t11",
      trapPl = "Zmiana klasy magazynu bez zmiany klucza", trapEn = "Changing a store class without changing the key",
      wrongCode = "store session secure\n  single Text\n  key \"app.session.v1\"",
      rightCode = "store session secure\n  single Text\n  key \"app.session.v2\"",
      whyPl = "Zmiana klasy zmienia sposób zapisu, więc dane zapisane starą klasą byłyby nieczytelne. Podnieś numer wersji w kluczu.", whyEn = "Changing the class changes the storage format, so data written by the old class would be unreadable. Bump the version in the key."),
    TrapRow(id = "t12",
      trapPl = "Warunek bez gałęzi else, gdy obie ścieżki są potrzebne", trapEn = "A condition without else when both paths are needed",
      wrongCode = "if isReady\n  button \"Dalej\"",
      rightCode = "if isReady\n  button \"Dalej\"\nelse\n  button \"Czekaj\"",
      whyPl = "Jeśli użytkownik musi wiedzieć, co się dzieje w obu przypadkach, potrzebna jest gałąź else. Interfejs bez niej wygląda na zepsuty.", whyEn = "If the user must know what is happening in both cases, an else branch is needed. Without it the UI looks broken."),
    TrapRow(id = "t13",
      trapPl = "Nazwa typu z małej litery", trapEn = "A lowercase type name",
      wrongCode = "data message\n  id Text",
      rightCode = "data Message\n  id Text",
      whyPl = "Nazwy typów piszemy z wielkiej litery. To ostrzeżenie, ale przy pracy z modelem warto trzymać konwencję od początku.", whyEn = "Type names start uppercase. It is a warning, but when working with a model it pays to keep the convention from the start."),
    TrapRow(id = "t14",
      trapPl = "Wysyłanie wyniku AI bez potwierdzenia", trapEn = "Sending AI output without confirmation",
      wrongCode = "when changed value\n  sendMessage(transcript)",
      rightCode = "when changed value\n  set candidate = transcript\n\nbutton \"Potwierdź i wyślij\"\n  accessibility label \"Potwierdź transkrypcję i wyślij\"\n  when tapped\n    sendMessage(candidate)",
      whyPl = "Transkrypcja i rozpoznanie znaku bywają błędne. Człowiek zatwierdza, zanim treść trafi do innych.", whyEn = "Transcription and sign recognition are imperfect. A human confirms before the text reaches others."),
    TrapRow(id = "t15",
      trapPl = "Opis stanu w miejscu przeznaczonym na wartość", trapEn = "A description where a value belongs",
      wrongCode = "state isBusy Boolean = \"trwa ładowanie\"",
      rightCode = "state isBusy Boolean = false",
      whyPl = "Typ wyznacza kształt wartości. Opis stanu to komentarz albo tekst w interfejsie, nie wartość flagi.", whyEn = "The type defines the value shape. A state description is a comment or UI text, not a boolean value.")
  ]
  save traps


// ============================================================================
// KOMPILATOR W APLIKACJI — przyjmuje DOWOLNY plik .ax
//
// Cztery etapy: lekser, parser, weryfikator, raport. Ten sam kod obsługuje
// każdy plik .ax, nie tylko ten. Dzięki temu bot dostaje sprzężenie zwrotne:
// wkleja kod, dostaje listę błędów z kodem AX, linią i sugestią.
// ============================================================================

global state srcText Text = ""
global state lexCount Number = 0
global state parseCount Number = 0
global state diagCount Number = 0
global state runOk Boolean = false
global state runStage Text = ""

data Token
  kind Text
  line Number
  indent Number
  text Text

data Diagnostic
  code Text
  line Number
  severity Text
  messagePl Text
  messageEn Text
  fixPl Text
  fixEn Text

store tokens local
  list Token
  key "axcode.tokens.v3"

store diagnostics local
  list Diagnostic
  key "axcode.diag.v3"

// --- LEKSER: tekst na tokeny -----------------------------------------------

function lexLine(raw Text, lineNo Number) returns Token
  set indent = countIndent(raw)
  set stripped = trimText(raw)
  if length(stripped) is 0
    return Token(kind = "blank", line = lineNo, indent = indent, text = "")
  if startsWith(stripped, "//")
    return Token(kind = "comment", line = lineNo, indent = indent, text = stripped)
  if hasMixedIndent(raw)
    return Token(kind = "badindent", line = lineNo, indent = indent, text = stripped)
  set head = firstWord(stripped)
  if isSectionKeyword(head)
    return Token(kind = "decl", line = lineNo, indent = indent, text = stripped)
  if contains(stripped, "(")
    return Token(kind = "call", line = lineNo, indent = indent, text = stripped)
  return Token(kind = "stmt", line = lineNo, indent = indent, text = stripped)

function lexAll(source Text)
  clear tokens
  set lines = splitText(source, newline())
  set index = 0
  for line in lines
    set index = index + 1
    add lexLine(line, index) to tokens
  save tokens
  set lexCount = length(tokens)
  set runStage = "lekser"

function countIndent(line Text) returns Number
  set count = 0
  for index in range(0, length(line))
    set ch = charAt(line, index)
    if ch is " "
      set count = count + 1
    else if ch is "\t"
      set count = count + 2
    else
      return count
  return count

function hasMixedIndent(line Text) returns Boolean
  set before = true
  set seenTab = false
  set seenSpace = false
  for index in range(0, length(line))
    set ch = charAt(line, index)
    if ch is " " and before
      set seenSpace = true
    else if ch is "\t" and before
      set seenTab = true
    else
      set before = false
  return seenTab and seenSpace

function isSectionKeyword(word Text) returns Boolean
  if word is "app"
    return true
  if word is "theme"
    return true
  if word is "style"
    return true
  if word is "enum"
    return true
  if word is "data"
    return true
  if word is "store"
    return true
  if word is "global"
    return true
  if word is "permission"
    return true
  if word is "api"
    return true
  if word is "function"
    return true
  if word is "component"
    return true
  if word is "screen"
    return true
  if word is "test"
    return true
  if word is "ui"
    return true
  return false

// --- PARSER: tokeny na strukturę -------------------------------------------

function parseAll()
  clear diagnostics
  set screenNames = []
  set modelNames = []
  set storeNames = []
  set fnNames = []

  // pierwsze przejście: zbierz nazwy zadeklarowane w pliku
  set pendingKind = ""
  for token in tokens
    if token.kind is "decl"
      set head = firstWord(token.text)
      if head is "screen"
        set screenNames = addUnique(screenNames, nthWord(token.text, 2))
      if head is "data"
        set modelNames = addUnique(modelNames, nthWord(token.text, 2))
      if head is "enum"
        set modelNames = addUnique(modelNames, nthWord(token.text, 2))
      if head is "store"
        set storeNames = addUnique(storeNames, nthWord(token.text, 2))
      if head is "function"
        set fnNames = addUnique(fnNames, nameBeforeParen(token.text))

  // drugie przejście: sprawdź reguły
  set prevIndent = 0
  set inStore = false
  set inScreen = false
  set storeHasKey = false
  set storeIsSecure = false
  set storeName = ""

  for token in tokens
    if token.kind is "blank" or token.kind is "comment"
      continue

    if token.kind is "badindent"
      pushDiag("AX1005", token.line, "error", "Mieszane wcięcie w jednej linii.", "Mixed indentation in one line.", "Zamień tabulator na dwie spacje.", "Replace the tab with two spaces.")
      continue

    if token.kind is "decl"
      set head = firstWord(token.text)

      // zamknięcie poprzedniego magazynu
      if inStore
        if storeHasKey is false
          pushDiag("AX4004", token.line, "error", "Magazyn " + storeName + " nie ma klucza.", "Store " + storeName + " has no key.", "Dopisz linię key z numerem wersji.", "Add a key line with a version number.")
        if storeIsSecure is false
          if looksLikeSecret(storeName)
            pushDiag("AX6001", token.line, "error", "Magazyn " + storeName + " przechowuje sekret bez klasy secure.", "Store " + storeName + " holds a secret without the secure class.", "Zmień klasę magazynu na secure.", "Change the store class to secure.")
        set inStore = false

      if head is "screen"
        set inScreen = true
        set screenTitleFound = false
      else
        set inScreen = false

      if head is "store"
        set inStore = true
        set storeHasKey = false
        set storeName = nthWord(token.text, 2)
        set storeIsSecure = contains(token.text, "secure") or contains(token.text, "encrypted")

      if head is "global"
        if contains(token.text, "=") is false
          pushDiag("AX4002", token.line, "error", "Stan globalny bez wartości początkowej.", "Global state without an initial value.", "Dopisz wartość po znaku równości.", "Add a value after the equals sign.")
        if contains(token.text, "True") or contains(token.text, "False")
          pushDiag("AX1003", token.line, "error", "Flaga zapisana wielką literą.", "Boolean written uppercase.", "Zapisz true i false małymi literami.", "Write true and false in lowercase.")
        if contains(token.text, "null") or contains(token.text, "nil")
          pushDiag("AX1003", token.line, "error", "Pusta wartość zapisana jako null albo nil.", "Empty value written as null or nil.", "Użyj słowa none.", "Use the word none.")

      if head is "api"
        set inApi = true
        set apiBase = ""
      else
        set inApi = false

      if head is "test" or head is "ui" or head is "accessibility"
        set runStage = "testy"

    // wnętrze bloku
    if token.kind is "stmt" or token.kind is "call"
      set text = token.text

      if inStore
        if startsWith(text, "key ")
          set storeHasKey = true

      if inScreen
        if startsWith(text, "title ")
          set screenTitleFound = true

      if startsWith(text, "go to ")
        set target = nthWord(text, 3)
        if contains(screenNames, target) is false
          pushDiag("AX8001", token.line, "error", "Nawigacja do nieistniejącego ekranu: " + target + ".", "Navigation to a non-existent screen: " + target + ".", "Popraw nazwę albo dodaj brakujący ekran.", "Fix the name or add the missing screen.")

      if startsWith(text, "image ")
        set hasAlt = false
        set imageLine = token.line
        set markLine = token.line
      if startsWith(text, "alt ")
        set hasAlt = true

      if startsWith(text, "field ")
        set fieldHasLabel = false
        set fieldLine = token.line
      if startsWith(text, "label ")
        set fieldHasLabel = true

      if contains(text, "http://")
        pushDiag("AX6002", token.line, "error", "Adres bez HTTPS.", "Address without HTTPS.", "Zmień na https.", "Change to https.")

      if startsWith(text, "base ") and contains(text, "http://")
        pushDiag("AX6002", token.line, "error", "Warstwa api używa HTTP.", "The api layer uses HTTP.", "Zmień adres bazowy na https.", "Change the base address to https.")

      if contains(text, "True") or contains(text, "False")
        pushDiag("AX1003", token.line, "error", "Flaga wielką literą.", "Boolean uppercase.", "Użyj true albo false.", "Use true or false.")

  save tokens
  set parseCount = length(diagnostics)
  set diagCount = length(diagnostics)
  set runStage = "parser"

function looksLikeSecret(name Text) returns Boolean
  set lower = strLower(name)
  if contains(lower, "key")
    return true
  if contains(lower, "token")
    return true
  if contains(lower, "secret")
    return true
  if contains(lower, "auth")
    return true
  return false

function pushDiag(code Text, line Number, severity Text, msgPl Text, msgEn Text, fixPl Text, fixEn Text)
  add Diagnostic(code = code, line = line, severity = severity, messagePl = msgPl, messageEn = msgEn, fixPl = fixPl, fixEn = fixEn) to diagnostics

// --- URUCHOMIENIE PEŁNEGO POTOKU -------------------------------------------

function runCompiler()
  if length(srcText) is 0
    announceImportant("Wklej kod AXCode, żeby go sprawdzić.")
    return
  set runStage = "lekser"
  lexAll(srcText)
  set runStage = "parser"
  parseAll()
  set runOk = length(diagnostics) is 0
  set runStage = "gotowe"
  if runOk
    announceImportant("Kod jest poprawny. Lekser zebrał " + lexCount + " tokenów, nie ma błędów.")
  else
    announceImportant("Znaleziono " + length(diagnostics) + " uwag. Przejrzyj listę i popraw.")

function loadSampleGood()
  set srcText = "app \"Notatnik\"\nversion \"1.0.0\"\nlanguage pl\nsupports ios android web\nentry Home\n\ntheme default\n  follows system\n  color primary #4F46E5\n  radius medium 16\n\ndata Note\n  id Text\n  body Text\n  createdAt Date\n\nstore notes local\n  list Note\n  key \"app.notes.v1\"\n\nglobal state draft Text = \"\"\n\nscreen Home\n  title \"Notatnik\"\n\n  state isBusy Boolean = false\n\n  column\n    padding 20\n    gap 16\n\n    text \"Moje notatki\"\n      style title\n\n    list notes\n      empty\n        text \"Brak notatek\"\n          style caption\n      item note\n        text note.body\n          style body\n\n    field draft\n      label \"Nowa notatka\"\n      max length 2000\n      error \"Notatka jest za długa.\"\n\n    button \"Dodaj\"\n      style buttonPrimary\n      accessibility label \"Dodaj notatkę\"\n      when tapped\n        addNote(draft)"
  announceLocal("Wczytano poprawny przykład.")

function loadSampleBad()
  set srcText = "Notatnik\nversion 1.0\n\nglobal state isOnline Boolean\n\ndata note\n  id Text\n\nstore apiKeys local\n  list Text\n  key \"a.v1\"\n\nscreen Home\n  column\n\n    image \"hero.png\"\n      width 200\n\n    field email\n      type email\n\n    button icon \"mic\"\n      when tapped\n        go to Profil"
  announceLocal("Wczytano przykład z błędami. Uruchom sprawdzanie.")

function diagCountByCode(code Text) returns Number
  set count = 0
  for diag in diagnostics
    if diag.code is code
      set count = count + 1
  return count



// ---------------------------------------------------------------------------
// Aliasy modeli danych.
//
// Poniższe nazwy występują w listach danych jako konstruktory modeli. Parser
// rozpoznaje konstruktor po wielkiej literze i nazwie zadeklarowanego modelu.
// Te komponenty istnieją po to, żeby nazwa była jednoznaczna w obu rolach:
// jako model danych przy tworzeniu wartości i jako element interfejsu, gdyby
// ktoś chciał go użyć do wyświetlenia jednego wiersza.
// ---------------------------------------------------------------------------

component GrammarRuleRow(rule GrammarRule)
  cardRaised
    column
      gap 8

      text rule.nonterminal
        style heading

      text rule.production
        style code
        max lines 6

component LexemeRow(item Lexeme)
  row
    gap 10
    align center
    justify spaceBetween

    text item.kind
      style heading

    text item.example
      style mono

component RuleSetRow(rule RuleSet)
  cardRaised
    column
      gap 10

      text rule.number + " · " + rule.errorCode
        style badge

      text rule.titlePl
        style heading

      text rule.rulePl
        style body

component ErrorRowView(item ErrorRow)
  card
    column
      gap 8

      text item.code
        style badgeErr

      text item.causePl
        style body

component TrapRowView(trap TrapRow)
  cardRaised
    column
      gap 10

      text trap.trapPl
        style heading

      text trap.wrongCode
        style codeBad
        max lines 6

// ============================================================================
// KOMPONENTY
// ============================================================================

component EmptyState(title Text, hint Text)
  column
    padding 26
    gap 8
    align center

    text title
      style heading

    text hint
      style caption
      max lines 3

// ============================================================================
// EKRANY — podręcznik, gramatyka, reguły, błędy, pułapki, kompilator
// ============================================================================

screen Podrecznik
  title "AXCode — podręcznik"

  when screen appears
    load grammar
    load rules
    load errors
    load traps
    load lexemes
    loadGrammar()
    loadRules()
    loadErrors()
    loadTraps()
    announceLocal("Podręcznik AXCode. Sekcje: gramatyka, reguły, błędy, pułapki, kompilator.")

  scroll
    direction vertical

    column
      padding 20
      gap 20

      cardRaised
        column
          gap 12

          text "PODRĘCZNIK PEŁNY"
            style overline

          text "AXCode"
            style display

          text "Kompletna specyfikacja języka w dwóch językach. Każda reguła ma opis, składnię, przykład poprawny, kontrprzykład błędny i kod błędu, który zgłosi kompilator. Dzięki temu model uczy się wzorca, a nie zgaduje."
            style body
            max lines 5

          text "Complete language specification in two languages. Every rule has a description, syntax, a correct example, a wrong example and the error code the compiler reports. A model therefore learns the pattern instead of guessing."
            style bodyEn
            max lines 5

          row
            gap 8
            align center

            button "PL + EN"
              style pillActive
              accessibility label "Pokaż podręcznik w obu językach"
              when tapped
                set langMode = "both"

            button "Tylko PL"
              style pill
              accessibility label "Pokaż podręcznik tylko po polsku"
              when tapped
                set langMode = "pl"

            button "English only"
              style pill
              accessibility label "Show the handbook in English only"
              when tapped
                set langMode = "en"

          text "Liczby: jednostek gramatyki " + length(grammar) + ", reguł " + length(rules) + ", kodów błędów " + length(errors) + ", pułapek " + length(traps) + ", reguł leksera " + length(lexemes)
            style caption

      row
        gap 8
        align center

        button "Gramatyka"
          style pill
          accessibility label "Przejdź do gramatyki formalnej"
          when tapped
            set section = "gramatyka"

        button "Reguły"
          style pill
          accessibility label "Przejdź do reguł języka"
          when tapped
            set section = "reguly"

        button "Błędy"
          style pill
          accessibility label "Przejdź do katalogu błędów"
          when tapped
            set section = "bledy"

        button "Pułapki"
          style pill
          accessibility label "Przejdź do listy pułapek"
          when tapped
            set section = "pulapki"

        button "Kompilator"
          style pill
          accessibility label "Przejdź do kompilatora w aplikacji"
          when tapped
            set section = "kompilator"

      if section is "gramatyka"
        column
          gap 16

          text "GRAMATYKA FORMALNA"
            style overline

          text "Zapis w notacji EBNF"
            style title

          text "To kontrakt, nie opis. Parser implementuje dokładnie te reguły."
            style body

          text "This is a contract, not a description. The parser implements exactly these rules."
            style bodyEn

          list grammar
            empty
              EmptyState("Brak reguł gramatyki", "Wczytaj treść ponownie.")

            item rule
              cardRaised
                column
                  gap 10

                  row
                    gap 10
                    align center
                    justify spaceBetween

                    text rule.nonterminal
                      style heading

                    text rule.id
                      style badge

                  text rule.production
                    style code
                    max lines 6

                  if langMode is "both" or langMode is "pl"
                    text rule.notePl
                      style body

                  if langMode is "both" or langMode is "en"
                    text rule.noteEn
                      style bodyEn

          text "REGUŁY LEKSERA"
            style overline

          text "Co parser rozpoznaje jako pojedynczy element"
            style heading

          list lexemes
            empty
              EmptyState("Brak reguł leksera", "Wczytaj treść ponownie.")

            item item
              card
                column
                  gap 8

                  row
                    gap 10
                    align center
                    justify spaceBetween

                    text item.kind
                      style heading

                    text item.example
                      style mono

                  text item.pattern
                    style caption

                  if langMode is "both" or langMode is "pl"
                    text item.notePl
                      style body

                  if langMode is "both" or langMode is "en"
                    text item.noteEn
                      style bodyEn

      if section is "reguly"
        column
          gap 16

          text "REGUŁY"
            style overline

          text "Dwadzieścia reguł z przykładami"
            style title

          text "Każda reguła ma zapis poprawny i zapis błędny oraz kod, który zgłosi kompilator."
            style body

          list rules
            empty
              EmptyState("Brak reguł", "Wczytaj treść ponownie.")

            item rule
              cardRaised
                column
                  gap 12

                  row
                    gap 10
                    align center
                    justify spaceBetween

                    text rule.number
                      style badge

                    text rule.errorCode
                      style badgeErr

                  if langMode is "both" or langMode is "pl"
                    text rule.titlePl
                      style heading

                  if langMode is "both" or langMode is "en"
                    text rule.titleEn
                      style heading

                  if langMode is "both" or langMode is "pl"
                    text rule.rulePl
                      style body

                  if langMode is "both" or langMode is "en"
                    text rule.ruleEn
                      style bodyEn

                  text rule.syntax
                    style mono

                  text "POPRAWNIE"
                    style overline

                  text rule.goodCode
                    style codeGood
                    max lines 14

                  text "BŁĘDNIE"
                    style overline

                  text rule.badCode
                    style codeBad
                    max lines 10

                  text "KOD BŁĘDU"
                    style overline

                  text rule.errorCode + " — " + rule.errorName
                    style badgeErr

                  if langMode is "both" or langMode is "pl"
                    text rule.fixPl
                      style body

                  if langMode is "both" or langMode is "en"
                    text rule.fixEn
                      style bodyEn

      if section is "bledy"
        column
          gap 16

          text "KATALOG BŁĘDÓW"
            style overline

          text "Dwadzieścia pięć kodów z poprawkami"
            style title

          list errors
            empty
              EmptyState("Brak błędów w katalogu", "Wczytaj treść ponownie.")

            item item
              card
                column
                  gap 10

                  row
                    gap 10
                    align center
                    justify spaceBetween

                    text item.code
                      style badgeErr

                    text item.rangePl
                      style caption

                  text item.sample
                    style codeBad
                    max lines 6

                  if langMode is "both" or langMode is "pl"
                    text item.causePl
                      style body

                  if langMode is "both" or langMode is "en"
                    text item.causeEn
                      style bodyEn

                  text "POPRAWKA"
                    style overline

                  if langMode is "both" or langMode is "pl"
                    text item.fixPl
                      style body

                  if langMode is "both" or langMode is "en"
                    text item.fixEn
                      style bodyEn

      if section is "pulapki"
        column
          gap 16

          text "PUŁAPKI"
            style overline

          text "Piętnaście miejsc, gdzie model się myli"
            style title

          text "Ta sekcja jest instrukcją dla modelu: czego nie robić i co zrobić zamiast. Bez tego trzeba by zgadywać i sprawdzać po kolei."
            style body

          text "This section is an instruction for a model: what not to do and what to do instead. Without it, one would have to guess and trial-and-error."
            style bodyEn

          list traps
            empty
              EmptyState("Brak pułapek", "Wczytaj treść ponownie.")

            item trap
              cardRaised
                column
                  gap 12

                  if langMode is "both" or langMode is "pl"
                    text trap.trapPl
                      style heading

                  if langMode is "both" or langMode is "en"
                    text trap.trapEn
                      style heading

                  text "BŁĘDNIE"
                    style overline

                  text trap.wrongCode
                    style codeBad
                    max lines 8

                  text "POPRAWNIE"
                    style overline

                  text trap.rightCode
                    style codeGood
                    max lines 10

                  if langMode is "both" or langMode is "pl"
                    text trap.whyPl
                      style body

                  if langMode is "both" or langMode is "en"
                    text trap.whyEn
                      style bodyEn

      if section is "kompilator"
        column
          gap 16

          text "KOMPILATOR"
            style overline

          text "Sprawdź dowolny plik .ax"
            style title

          text "Wklej kod i uruchom. Dostaniesz tokeny, listę uwag z kodem AX, linią i sugestią poprawki. Ten kompilator obsługuje każdy plik w tym języku, nie tylko ten."
            style body

          button "Wczytaj poprawny przykład"
            style buttonSecondary
            accessibility label "Wczytaj poprawny przykład kodu"
            when tapped
              loadSampleGood()

          button "Wczytaj przykład z błędami"
            style buttonSecondary
            accessibility label "Wczytaj przykład kodu z błędami"
            when tapped
              loadSampleBad()

          field srcText
            label "Kod źródłowy AXCode"
            placeholder "Wklej tutaj swój plik .ax"
            max length 200000
            error "Kod jest za długi."

          button "Sprawdź kod"
            style buttonPrimary
            accessibility label "Uruchom kompilator na wklejonym kodzie"
            when tapped
              runCompiler()

          if length(runStage) > 0
            card
              column
                gap 8

                text "WYNIK"
                  style overline

                text "Etap: " + runStage
                  style caption

                text "Tokenów: " + lexCount
                  style caption

                text "Uwag: " + diagCount
                  style caption

                if runOk
                  text "Kod jest poprawny"
                    style badgeOk
                else
                  text "Są uwagi do poprawy"
                    style badgeErr

          list diagnostics
            empty
              text "Brak uwag. Kod przeszedł pierwsze etapy."
                style caption

            item diag
              card
                column
                  gap 8

                  row
                    gap 10
                    align center
                    justify spaceBetween

                    text diag.code
                      style badgeErr

                    text "linia " + diag.line
                      style caption

                  if langMode is "both" or langMode is "pl"
                    text diag.messagePl
                      style body

                  if langMode is "both" or langMode is "en"
                    text diag.messageEn
                      style bodyEn

                  text "POPRAWKA"
                    style overline

                  if langMode is "both" or langMode is "pl"
                    text diag.fixPl
                      style caption

                  if langMode is "both" or langMode is "en"
                    text diag.fixEn
                      style caption

      card
        column
          gap 10

          text "JAK UCZYĆ SIĘ TEGO PODRĘCZNIKA"
            style overline

          text "Przejdź sekcje w kolejności: gramatyka, potem reguły, potem pułapki. Przy każdej regule przeczytaj przykład poprawny i błędny razem — dopiero różnica między nimi pokazuje regułę."
            style body

          text "Walk the sections in order: grammar, then rules, then traps. For each rule read the correct and the wrong example together — the difference between them is what carries the rule."
            style bodyEn

          text "W sekcji kompilatora wklej własny kod. Kod błędu wskaże, która reguła została złamana, więc nie trzeba zgadywać."
            style body

      text "Autor: Axel G"
        style overline

      text "https://www.instagram.com/axelgadomski"
        style caption

test "Gramatyka ma trzydzieści reguł"
  given value loadGrammar()
  when length(grammar)
  then result is 30

test "Reguł języka jest dwadzieścia"
  given value loadRules()
  when length(rules)
  then result is 20

test "Katalog błędów ma dwadzieścia pięć kodów"
  given value loadErrors()
  when length(errors)
  then result is 25

test "Pułapek jest piętnaście"
  given value loadTraps()
  when length(traps)
  then result is 15

accessibility test "Podręcznik AXCode"
  open Podrecznik
  expect all fields have labels
  expect all icon buttons have accessibility label
  expect contrast passes AA
  expect screen reader announces title
