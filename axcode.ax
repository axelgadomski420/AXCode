        style h3
      text stage.detail
        style body
        max lines 4

component ArchitectureDiagram()
  card
    column
      gap 4
      text "app.ax"
        style codeLine
      text "  |"
        style codeLine
      text "  v"
        style codeLine
      text "Lexer ---------> tokeny, pozycje, wciecia, komentarze"
        style codeLine
      text "  |"
        style codeLine
      text "  v"
        style codeLine
      text "Parser --------> drzewo skladniowe, dziewiec jednostek"
        style codeLine
      text "  |"
        style codeLine
      text "  v"
        style codeLine
      text "Type Checker --> typy, zasiegi, stany, uprawnienia, dostepnosc"
        style codeLine
      text "  |"
        style codeLine
      text "  v"
        style codeLine
      text "AXIR ----------> platformowo-neutralny graf aplikacji"
        style codeLine
      text "  |"
        style codeLine
      text "  +--> Optimizer"
        style codeLine
      text "  +--> Backend iOS ------> Swift + SwiftUI"
        style codeLine
      text "  +--> Backend Android --> Kotlin + Jetpack Compose"
        style codeLine
      text "  +--> Backend Web ------> Wasm + TypeScript + DOM"
        style codeLine
      text "  +--> Serwer deweloperski: hot reload, inspektor dostepnosci"
        style codeLine

screen Start
  title "AXCode"

  when screen appears
    loadContent
    loadSource
    announceLocal("Strona języka AXCode.")

  scroll
    direction vertical

    column
      gap 0

      NavBar()

      column
        padding 24
        gap 24

        row
          gap 8
          align center
          text "Kompilator działa w tej przeglądarce · dziesięć warstw"
            style badge

        text "Jeden plik."
          style hero

        text "Cała aplikacja."
          style heroAccent

        text "AXCode to deklaratywny język aplikacji. Jeden plik .ax opisuje interfejs, stan, dane, nawigację, bezpieczeństwo, dostępność, tryb offline i testy."
          style lead
          max lines 4

        row
          gap 14
          align center
          button "Uruchom kompilator"
            style buttonPrimary
            accessibility label "Przejdź do sekcji kompilatora"
            when tapped
              goTo("Kompilator")
          button "Zobacz składnię"
            style buttonGhost
            accessibility label "Przejdź do sekcji składni"
            when tapped
              goTo("Skladnia")

        grid
          columns 4
          gap 14
          list metricList()
            empty
              text "Brak danych."
                style caption
            item metric
              MetricBox(metric)

      column
        padding 24
        gap 20

        text "Dowód działania"
          style tag

        text "Nie mockup. Kompilator, który czyta prawdziwy kod."
          style h1

        text "Poniżej działa lexer, parser, weryfikator semantyczny i runtime renderujący. Zmień cokolwiek w źródle — strona przeliczy się sama."
          style lead
          max lines 4

        card
          column
            gap 14

            row
              gap 12
              align center
              justify spaceBetween
              text "Kompilator AXCode"
                style subheading
              row
                gap 10
                align center
                button "Kompiluj"
                  style buttonPrimary
                  accessibility label "Uruchom kompilację źródła"
                  when tapped
                    compileSource()

                button "Wczytaj źródło"
                  style buttonTab
                  accessibility label "Wczytaj źródło tej strony"
                  when tapped
                    loadSource()
                checkbox showSource
                  accessibility label "Pokaż albo ukryj źródło"

            if showSource
              field sourceText
                label "Źródło w języku AXCode"
                max length 400000

            text "Wynik kompilacji"
              style caption

            text compileStatus
              style body

            list compileFindings
              empty
                text "Brak znalezisk. Dostępność, nawigacja, typy i magazyny przeszły kontrolę."
                  style badge
              item finding
                text finding
                  style caption

      column
        padding 24
        gap 20

        text "Filozofia"
          style tag

        text "Język warstwy aplikacji, nie język systemowy."
          style h1

        text "AXCode nie zastępuje Swifta, Kotlina ani Rusta. Opisuje ekrany, stan, dane, nawigację, uprawnienia, dostępność i testy — czyli warstwę, którą dziś pisze się trzy razy."
          style lead
          max lines 4

        grid
          columns 2
          gap 18
          list featureList()
            empty
              text "Brak treści."
                style caption
            item feature
              FeatureCard(feature)

      column
        padding 24
        gap 20

        text "Składnia"
          style tag

        text "Kod, który czyta się jak specyfikacja produktu."
          style h1

        text "Wcięcie jest składnią. Typ idzie po nazwie. Komentarze to dwa ukośniki. Trzy zasady, które modele AI mylą najczęściej."
          style lead
          max lines 4

        column
          gap 24
          list syntaxList()
            empty
              text "Brak przykładów."
                style caption
            item block
              SyntaxWindow(block)

      column
        padding 24
        gap 20

        text "Architektura"
          style tag

        text "Jeden front-end. Wiele backendów."
          style h1

        text "Kompilator nie tłumaczy AXCode bezpośrednio na Swift, Kotlin czy JavaScript. Tworzy neutralny graf aplikacji, a dopiero na jego podstawie generuje kod platform."
          style lead
          max lines 4

        ArchitectureDiagram()

        text "Dziesięć warstw tej implementacji"
          style h2

        column
          gap 16
          list layerList()
            empty
              text "Brak warstw."
                style caption
            item layer
              LayerRow(layer)

        text "Etapy rozwoju"
          style h2

        grid
          columns 2
          gap 18
          list stageList()
            empty
              text "Brak etapów."
                style caption
            item stage
              StageCard(stage)

      column
        padding 24
        gap 20

        text "Specyfikacja"
          style tag

        text "Kody błędów, które uczą."
          style h1

        text "Każdy błąd ma identyfikator, kategorię, pozycję, wyjaśnienie i proponowaną poprawkę. Komunikat nie tylko przerywa budowanie — mówi, co zrobić."
          style lead
          max lines 4

        column
          gap 12
          list errorList()
            empty
              text "Brak klas błędów."
                style caption
            item error
              ErrorRow(error)

        text "Przykład komunikatu"
          style h2

        card
          column
            gap 4
            text "[AX7002] Przycisk ikonowy bez etykiety dostepnosci w ekranie Profile (linia 1841)."
              style codeLine
            text " "
              style codeLine
            text "Poprawka: Dodaj accessibility label \"opis akcji\"."
              style codeLine
            text " "
              style codeLine
            text "[AX6001] Magazyn apiKeys wyglada na przechowujacy sekrety, ale nie ma klasy secure ani encrypted."
              style codeLine
            text " "
              style codeLine
            text "Poprawka: Zmien na: store apiKeys secure"
              style codeLine

      column
        padding 24
        gap 20

        text "Dla modeli AI"
          style tag

        text "Sześć pułapek, których nie da się zgadnąć."
          style h1

        text "Dokumentacja techniczna jest dołączona do kompilatora. Powiedz dowolnemu modelowi, żeby ją przeczytał, zanim zacznie pisać w AXCode."
          style lead
          max lines 4

        grid
          columns 2
          gap 18
          list pitfallList()
            empty
              text "Brak treści."
                style caption
            item pitfall
              PitfallCard(pitfall)

      column
        padding 24
        gap 20


      column
        padding 24
        gap 20

        text "Podejscie naukowe"
          style tag

        text "Metoda, hipotezy, pomiary i ograniczenia."
          style h1

        text "Strona opisuje jezyk nie tylko jako produkt, ale jako przedmiot analizy. Ponizej metoda badawcza, hipotezy z wynikami, zestaw pomiarow, jawnie wypisane ograniczenia oraz bibliografia."
          style lead
          max lines 4

        text "Metoda badawcza"
          style h2

        column
          gap 16
          list methodList()
            empty
              text "Brak krokow metody."
                style caption
            item step
              MethodStepRow(step)

      column
        padding 24
        gap 20

        text "Hipotezy"
          style h2

        column
          gap 18
          list hypothesisList()
            empty
              text "Brak hipotez."
                style caption
            item hypothesis
              HypothesisCard(hypothesis)

      column
        padding 24
        gap 20

        text "Pomiary"
          style h2

        text "Wszystkie wartosci pochodza z rzeczywistych plikow projektu, nie z szacunkow."
          style caption
          max lines 3

        column
          gap 12
          list measureList()
            empty
              text "Brak pomiarow."
                style caption
            item measure
              MeasureRow(measure)

      column
        padding 24
        gap 20

        text "Ograniczenia"
          style h2

        text "Piec ograniczen wypisanych jawnie. Praca nie przedstawia jezyka jako rozwiazania bez wad."
          style caption
          max lines 3

        grid
          columns 2
          gap 18
          list limitationList()
            empty
              text "Brak ograniczen."
                style caption
            item limitation
              LimitationCard(limitation)

      column
        padding 24
        gap 20

        text "Bibliografia"
          style h2

        column
          gap 14
          list citationList()
            empty
              text "Brak pozycji."
                style caption
            item citation
              CitationRow(citation, citation.id)

      column
        padding 24
        gap 20

        text "Dokumenty do skopiowania"
          style h2

        text "Teksty gotowe do wklejenia na kompilator tego jezyka albo do dowolnego modelu AI, ktory ma pisac w AXCode. Kazdy dokument jest generowany z danych tej strony, wiec nie rozjedzie sie z trescia."
          style lead
          max lines 5

        row
          gap 12
          align center
          button "Skopiuj specyfikacje"
            style buttonPrimary
            accessibility label "Skopiuj specyfikacje jezyka do schowka"
            when tapped
              copySpec()
          button "Skopiuj pelny raport"
            style buttonSecondary
            accessibility label "Skopiuj pelny raport do schowka"
            when tapped
              copyFullReport()

        row
          gap 12
          align center
          button "Skopiuj metode badawcza"
            style buttonGhost
            accessibility label "Skopiuj metode badawcza do schowka"
            when tapped
              copyMethod()
          button "Skopiuj bibliografie"
            style buttonGhost
            accessibility label "Skopiuj bibliografie do schowka"
            when tapped
              copyCitations()

        if length(clipboardText) > 0
          card
            column
              gap 8
              text "Skopiowano do schowka"
                style subheading
              text length(clipboardText) + " znakow gotowych do wklejenia."
                style caption

        text "Zawartosc dokumentow"
          style subheading

        card
          column
            gap 4
            text "specyfikacja: jednostki programu, typy, klasy magazynow, zdarzenia, kontenery, elementy, reguly kompilatora, kody bledow"
              style codeLine
            text "metoda: szesc krokow z celem i artefaktem kazdego"
              style codeLine
            text "pomiary: dwanascie wartosci z probka zrodlowa"
              style codeLine
            text "raport pelny: wszystkie powyzsze w jednym tekscie"
              style codeLine

        text "AXCode"
          style h2

        text "Deklaratywny język aplikacji. Autor: Axel G."
          style body

        text "@axelgadomski"
          style caption

        row
          gap 12
          align center
          button "Od początku"
            style buttonGhost
            accessibility label "Wróć do początku strony"
            when tapped
              goTo("Start")
          button "GitHub"
            style buttonGhost
            accessibility label "Otwórz repozytorium AXCode"
            when tapped
              openUrl("https://github.com/axelgadomski420/AXCode")

test "Lista możliwości ma cztery pozycje"
  given value loadContent()
  when length(featureList())
  then result is 4

test "Lista warstw ma dziesięć pozycji"
  given value loadContent()
  when length(layerList())
  then result is 10

test "Lista hipotez ma piec pozycji"
  given value loadContent()
  when length(hypothesisList())
  then result is 5

test "Lista pomiarow ma dwanascie pozycji"
  given value loadContent()
  when length(measureList())
  then result is 12

test "Dokument specyfikacji nie jest pusty"
  given value loadContent()
  when length(specDocument())
  then result is not 0

test "Pelny raport zawiera wszystkie sekcje"
  given value loadContent()
  when contains(fullReport(), "METODA BADAWCZA")
  then result is true

test "Przełączanie bloku kodu rozwija i zwija"
  given value toggleBlock("s1")
  when expandedBlock
  then result is "s1"

accessibility test "Strona AXCode"
  open Start
  expect all fields have labels
  expect all images have alt
  expect all icon buttons have accessibility label
  expect contrast passes AA
